# Ключ провайдера OpenAI-совместимого API. Пустое значение включает fallback без LLM.
OPENAI_API_KEY=

# Идентификатор каталога. Для Yandex AI Studio это folder_id.
OPENAI_PROJECT=

# Базовый URL: OpenAI, DeepSeek, Ollama или Yandex AI Studio.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com
# Yandex AI Studio:
# OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# OPENAI_PROJECT=<folder_id>
# OPENAI_MODEL=gpt://<folder_id>/aliceai-llm
OPENAI_BASE_URL=

# Имя модели у выбранного провайдера.
OPENAI_MODEL=gpt-4o-mini

# true — карточка дела собирается локально, без запроса к kad.arbitr.ru / sudrf.ru.
USE_MOCK_SCRAPER=true
